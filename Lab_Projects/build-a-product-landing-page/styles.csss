/* Reset basics */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  background-color: #f5f5f5;
  color: #222;
  line-height: 1.6;
  padding: 0 20px 40px;
}

/* Header */
#header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 10px 20px;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 1000;
  border-bottom: 2px solid #333;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

#header-img {
  height: 50px;
  width: auto;
}

#nav-bar {
  display: flex;
  gap: 20px;
}

.nav-link {
  text-decoration: none;
  color: #222;
  font-weight: 600;
  transition: color 0.3s ease;
}

.nav-link:hover,
.nav-link:focus {
  color: #555;
}

/* Sections */
section {
  max-width: 700px;
  margin: 100px auto 40px; /* spacing for fixed header */
  background-color: #fff;
  padding: 30px 25px;
  border-radius: 8px;
  box-shadow: 0 0 8px rgba(0,0,0,0.05);
}

section h2 {
  margin-bottom: 15px;
  font-size: 1.8rem;
  font-weight: 700;
  color: #000;
}

section ul {
  list-style: inside disc;
  color: #444;
}

section ul li {
  margin-bottom: 10px;
}

/* Video */
#video {
  width: 100%;
  max-height: 400px;
  border-radius: 8px;
  background: #000;
}

/* Form */
#form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

#email {
  padding: 10px 15px;
  font-size: 1rem;
  border: 2px solid #ccc;
  border-radius: 5px;
  outline-offset: 2px;
  transition: border-color 0.3s ease;
}

#email:focus {
  border-color: #333;
}

#submit {
  background-color: #222;
  color: #fff;
  font-weight: 700;
  border: none;
  padding: 12px;
  font-size: 1.1rem;
  cursor: pointer;
  border-radius: 5px;
  transition: background-color 0.3s ease;
}

#submit:hover,
#submit:focus {
  background-color: #555;
}

/* Media query for smaller screens */
@media (max-width: 600px) {
  #header {
    flex-direction: column;
    gap: 10px;
    padding: 15px 20px;
  }

  #nav-bar {
    justify-content: center;
    flex-wrap: wrap;
  }

  section {
    margin: 130px 10px 30px;
    padding: 20px 15px;
  }

  #video {
    max-height: 250px;
  }
}